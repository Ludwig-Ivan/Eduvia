<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- ATS: se permite HTTP solo en la red local, porque la API corre en
	     localhost:8080 durante el desarrollo (ver PlatformHttpClient.kt de iosMain).
	     No se habilita NSAllowsArbitraryLoads: el resto del tráfico exige HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>