# Plantilla de variables para docker-compose.yml. Copiar a `.env` y ajustar.
# NUNCA subir `.env` con secretos reales: está excluido por .gitignore.

# Base de datos: los tres valores deben coincidir con los que recibe la API.
DB_NAME=app
DB_USER=app
DB_PASSWORD=app

# Puertos publicados en el host. Cambiarlos permite levantar stacks paralelos
# (scripts/test-all.ps1 usa 18080/15432/18081; las pruebas manuales, otros).
DB_PORT=5432
API_PORT=8080
ADMINER_PORT=8081

# `dev` carga los datos de ejemplo de V1000__seed.sql. Usar `prod` sin semilla.
SPRING_PROFILES_ACTIVE=dev

# Obligatorio: Compose falla en arranque si no está definido (${JWT_SECRET:?...}).
# Debe tener al menos 32 caracteres; el valor de abajo es SOLO para desarrollo local.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
